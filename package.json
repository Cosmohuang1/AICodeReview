{
  "name": "ai-review",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server/app.js",
  "bin": {
    "ai-review": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/server/app.ts src/cli.ts src/mcp/server.ts --format esm --dts",
    "start": "node dist/server/app.js",
    "dev": "tsx watch src/server/app.ts",
    "review": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@octokit/app": "^15.0.0",
    "@octokit/rest": "^21.0.0",
    "@octokit/webhooks": "^13.0.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.7",
    "express": "^4.18.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.50.0",
    "parse-diff": "^0.11.0",
    "tree-sitter": "^0.21.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
